# Chaves grátis, sem cartão. Pode preencher só uma, se for ler só uma das redes.
# Solana: https://dashboard.helius.dev (plano Free)
HELIUS_API_KEY=
# EVM (Ethereum, Arbitrum, Polygon): https://etherscan.io/apidashboard (plano Free)
ETHERSCAN_API_KEY=
# EVM que a Etherscan grátis não cobre (Base, BNB, Robinhood Chain): https://dashboard.alchemy.com (plano Free)
# Ao criar o app na Alchemy, ligue essas três redes em Networks.
ALCHEMY_API_KEY=

# Opcional: WalletConnect (carteiras de celular). Grátis em https://cloud.reown.com
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Opcional: RPC Solana (padrão: mainnet-beta pública)
NEXT_PUBLIC_SOLANA_RPC=https://api.mainnet-beta.solana.com

# Banco de dados (só na Vercel). Sem isso os posts ficam em data/losses.json.
# Na Vercel, Storage → Create Database → Neon preenche sozinho. Para rodar o seed no banco a partir do PC, cole aqui o valor.
# DATABASE_URL=
